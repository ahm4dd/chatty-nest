{
  "compilerOptions": {
    "composite": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2022"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "customConditions": ["@chatty-nest/source"],
    "paths": {
      "@chatty-nest/source": ["./packages/*/src/index.ts"],
      "@chatty-nest/database": ["./packages/database/src/index.ts"],
      "@chatty-nest/shared-utils": ["./packages/shared-utils/src/index.ts"],
      "@chatty-nest/api": ["./apps/api/src/index.ts"]
    }
  }
}
