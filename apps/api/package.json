{
  "name": "@chatty-nest/api",
  "version": "0.0.1",
  "private": true,
  "scripts": {},
  "nx": {
    "targets": {
      "build": {
        "executor": "@nx/js:swc",
        "options": {
          "main": "src/main.ts",
          "outputPath": "apps/api/dist",
          "outputFileName": "main.js",
          "tsConfig": "tsconfig.app.json",
          "assets": [
            "src/assets"
          ],
          "skipTypeCheck": true,
          "stripLeadingPaths": true,
          "clean": true
        },
        "configurations": {
          "development": {}
        }
      },
      "prune-lockfile": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "executor": "@nx/js:prune-lockfile",
        "outputs": [
          "{workspaceRoot}/apps/api/dist/package.json",
          "{workspaceRoot}/apps/api/dist/pnpm-lock.yaml"
        ],
        "options": {
          "buildTarget": "build"
        }
      },
      "copy-workspace-modules": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "outputs": [
          "{workspaceRoot}/apps/api/dist/workspace_modules"
        ],
        "executor": "@nx/js:copy-workspace-modules",
        "options": {
          "buildTarget": "build"
        }
      },
      "prune": {
        "dependsOn": [
          "prune-lockfile",
          "copy-workspace-modules"
        ],
        "executor": "nx:noop"
      },
      "serve": {
        "executor": "nx:run-commands",
        "defaultConfiguration": "development",
        "dependsOn": [
          "build"
        ],
        "options": {
          "cwd": "apps/api"
        },
        "configurations": {
          "development": {
            "commands": [
              "swc src -d dist --strip-leading-paths --config-file .swcrc --watch",
              "node --watch dist/main.js"
            ],
            "parallel": true
          },
          "production": {
            "command": "node dist/main.js"
          }
        }
      },
      "test": {},
      "db:generate": {
        "executor": "nx:run-commands",
        "options": {
          "command": "drizzle-kit generate --config=drizzle.config.ts",
          "cwd": "packages/database"
        }
      },
      "db:migrate": {
        "executor": "nx:run-commands",
        "options": {
          "command": "drizzle-kit migrate --config=drizzle.config.ts",
          "cwd": "packages/database"
        }
      },
      "db:push": {
        "executor": "nx:run-commands",
        "options": {
          "command": "drizzle-kit push --config=drizzle.config.ts",
          "cwd": "packages/database"
        }
      },
      "db:studio": {
        "executor": "nx:run-commands",
        "options": {
          "command": "drizzle-kit studio",
          "cwd": "packages/database"
        }
      },
      "db:seed": {
        "executor": "nx:run-commands",
        "options": {
          "command": "node scripts/seed.ts",
          "cwd": "apps/api"
        }
      }
    }
  },
  "dependencies": {
    "@chatty-nest/database": "workspace:*",
    "@chatty-nest/shared-utils": "workspace:*",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.0",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.4.2",
    "@scalar/nestjs-api-reference": "^1.1.13",
    "argon2": "^0.44.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "drizzle-orm": "^0.45.2",
    "nestjs-cls": "^6.2.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.20.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.0",
    "tslib": "^2.3.0",
    "uwestjs": "^2.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.0",
    "chokidar": "^5.0.0"
  }
}
